root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,js,mjs,jsx,ts,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{rs,py}]
indent_style = space
indent_size = 4

[*.{swift,m,h,cpp,cc,c,sh}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
