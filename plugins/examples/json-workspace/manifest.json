{
  "schemaVersion": 1,
  "id": "dev.anywhere.json-workspace",
  "name": "JSON Workspace",
  "version": "0.7.1",
  "apiVersion": "1",
  "platforms": [
    "macos"
  ],
  "entry": "dist/index.html",
  "permissions": [
    {
      "name": "context.read",
      "types": [
        "core.text",
        "plugin.dev.anywhere.json-workspace.json"
      ]
    },
    {
      "name": "clipboard.writeText"
    },
    {
      "name": "storage.local"
    }
  ],
  "commands": [
    {
      "id": "open",
      "title": "JSON Workspace",
      "keywords": [
        "json",
        "jsonpath",
        "javascript",
        "query",
        "format",
        "格式化",
        "查询"
      ],
      "accepts": [
        "plugin.dev.anywhere.json-workspace.json"
      ],
      "entrypoint": "workspace"
    },
    {
      "id": "copy-format",
      "title": "Copy Formatted JSON",
      "keywords": [
        "json",
        "copy",
        "format",
        "复制格式化JSON"
      ],
      "accepts": [
        "plugin.dev.anywhere.json-workspace.json"
      ],
      "entrypoint": "copyFormatted",
      "requireContext": true,
      "runtime": "background"
    },
    {
      "id": "copy-minify",
      "title": "Copy Minified JSON",
      "keywords": [
        "json",
        "copy",
        "minify",
        "compact",
        "复制压缩JSON"
      ],
      "accepts": [
        "plugin.dev.anywhere.json-workspace.json"
      ],
      "entrypoint": "copyMinified",
      "requireContext": true,
      "runtime": "background"
    },
    {
      "id": "copy-escaped",
      "title": "Copy Escaped JSON",
      "keywords": [
        "json",
        "copy",
        "escape",
        "复制转义JSON"
      ],
      "accepts": [
        "plugin.dev.anywhere.json-workspace.json"
      ],
      "entrypoint": "copyEscaped",
      "requireContext": true,
      "runtime": "background"
    }
  ],
  "background": {
    "entry": "dist/background.js",
    "resolvers": [
      {
        "id": "json-document",
        "accepts": [
          "core.text"
        ],
        "produces": [
          "plugin.dev.anywhere.json-workspace.json"
        ],
        "entrypoint": "resolve"
      }
    ]
  }
}
