{
  "name": "@anywhere/sdk",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "anywhere-plugin": "tools/anywhere-plugin.mjs"
  },
  "exports": {
    ".": {
      "anywhere-background": {
        "types": "./dist/background.d.ts",
        "default": "./dist/background.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/controls.css": "./styles/controls.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    },
    "./mock/palettes.css": "./tools/mock-palettes.css",
    "./mock/background": {
      "types": "./tools/background-mock.d.mts",
      "import": "./tools/background-mock.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles",
    "tools",
    "schemas",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build && node tools/copy-schemas.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
