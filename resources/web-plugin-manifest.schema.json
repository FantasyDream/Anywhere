{
  "$defs": {
    "PluginBackground": {
      "additionalProperties": false,
      "description": "Code is compiled to one local ES module when building the package.",
      "properties": {
        "entry": {
          "type": "string"
        },
        "resolvers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginResolver"
          },
          "type": "array"
        }
      },
      "required": [
        "entry"
      ],
      "type": "object"
    },
    "PluginResolver": {
      "additionalProperties": false,
      "properties": {
        "accepts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "entrypoint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "produces": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "accepts",
        "produces",
        "entrypoint"
      ],
      "type": "object"
    },
    "PluginRuntime": {
      "enum": [
        "webview",
        "background"
      ],
      "type": "string"
    },
    "WebCommand": {
      "additionalProperties": false,
      "properties": {
        "accepts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "entrypoint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inputMatchers": {
          "description": "Host-owned content recognition. No plugin code runs during search or capture.",
          "items": {
            "$ref": "#/$defs/WebInputMatcher"
          },
          "type": "array"
        },
        "keywords": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requireInputMatch": {
          "description": "Hide commands that cannot run without recognized content, including keyword search.",
          "type": "boolean"
        },
        "runtime": {
          "$ref": "#/$defs/PluginRuntime"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "entrypoint"
      ],
      "type": "object"
    },
    "WebInputMatcher": {
      "oneOf": [
        {
          "const": "json",
          "description": "Strict JSON objects and arrays; scalars are ordinary search terms.",
          "type": "string"
        },
        {
          "const": "json_escaped",
          "description": "JSON containers encoded as a JSON string (optionally without outer quotes).",
          "type": "string"
        }
      ]
    },
    "WebPermission": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "context.read",
              "type": "string"
            },
            "types": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "name",
            "types"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "context.currentApp",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "input.read",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "input.write",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "app.frontmost",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "clipboard.readText",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "clipboard.writeText",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "storage.local",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "WebPlatform": {
      "enum": [
        "macos",
        "windows"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "1",
      "type": "string"
    },
    "background": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginBackground"
        },
        {
          "type": "null"
        }
      ]
    },
    "commands": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WebCommand"
      },
      "type": "array"
    },
    "entry": {
      "type": "string"
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "permissions": {
      "items": {
        "$ref": "#/$defs/WebPermission"
      },
      "type": "array"
    },
    "platforms": {
      "items": {
        "$ref": "#/$defs/WebPlatform"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "apiVersion",
    "platforms",
    "permissions"
  ],
  "title": "WebPluginManifest",
  "type": "object"
}
